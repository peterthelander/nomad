{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomad-multiplayer",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "WORLDS", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "vars": { "ALLOWED_ORIGINS": "https://peterthelander.github.io,http://localhost:8765,http://127.0.0.1:8765" }
}
